DATABASE_URL="postgresql://flowtus:flowtus@localhost:5432/flowtus?schema=public"
PORT=4000
# Secret used to sign admin session cookies and signed upload URLs. Generate with: openssl rand -hex 48
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
# Comma-separated origins allowed to call the API with credentials (the web and admin apps proxy /api, so this is a fallback).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Initial accounts created by `npm run db:seed`. Change the passwords; the seed refuses the defaults when NODE_ENV=production.
OWNER_EMAIL="owner@flowtus.local"
OWNER_PASSWORD="ChangeMe-Owner-2026"
STAFF_EMAIL="staff@flowtus.local"
STAFF_PASSWORD="ChangeMe-Staff-2026"
# Directory for private customer uploads (use an object store in production).
UPLOAD_DIR="./uploads"
# Enables "Load sample activity" and "Reset demo data" in the admin. Keep false in production.
ALLOW_DEMO_TOOLS=true
# Throw-away database for `npm test` (the e2e suite wipes orders/requests). Create it once:
#   docker compose exec db psql -U flowtus -d postgres -c "CREATE DATABASE flowtus_test;"
#   DATABASE_URL=<this url> npx prisma migrate deploy
DATABASE_URL_TEST="postgresql://flowtus:flowtus@localhost:5432/flowtus_test?schema=public"
PUBLIC_WEB_URL="http://localhost:3000"
